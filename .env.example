COMPOSE_PROJECT_NAME=observium-lab

# Observium web UI (http://localhost:8888)
OBSERVIUM_PORT=8888
OBSERVIUM_BASE_URL=http://localhost:8888
OBSERVIUM_ADMIN_USER=admin
OBSERVIUM_ADMIN_PASS=observium

# Database
MYSQL_ROOT_PASSWORD=observium
MYSQL_PASSWORD=observium

# SNMP community string (must match on client and when adding devices)
SNMP_COMMUNITY=public

# Timezone for graphs (e.g. America/New_York, Europe/London)
TZ=UTC
